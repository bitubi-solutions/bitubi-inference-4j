<dialog id="shortcuts" class="sheet" aria-labelledby="shortcuts-title">
  <form method="dialog">
    <h2 id="shortcuts-title">Keyboard shortcuts</h2>
    <table>
      <tbody>
        <tr><th scope="row"><kbd>Enter</kbd></th><td>Send the message</td></tr>
        <tr><th scope="row"><kbd>Shift</kbd> + <kbd>Enter</kbd></th><td>New line</td></tr>
        <tr><th scope="row"><kbd>Esc</kbd></th><td>Stop the answer, or close a panel or dialog</td></tr>
        <tr data-action="new-chat"><th scope="row"><kbd>Ctrl</kbd> or <kbd>Cmd</kbd> + <kbd>Shift</kbd> + <kbd>O</kbd></th><td>New chat (if your browser keeps this one, use the New chat link)</td></tr>
        <tr data-action="filter"><th scope="row"><kbd>Ctrl</kbd> or <kbd>Cmd</kbd> + <kbd>K</kbd></th><td>Search conversations</td></tr>
        <tr data-action="toggle-sidebar"><th scope="row"><kbd>Ctrl</kbd> or <kbd>Cmd</kbd> + <kbd>Shift</kbd> + <kbd>S</kbd></th><td>Show or hide the conversation list</td></tr>
        <tr data-action="help"><th scope="row"><kbd>?</kbd></th><td>Show this list</td></tr>
      </tbody>
    </table>
    <button class="secondary">Close</button>
  </form>
</dialog>
